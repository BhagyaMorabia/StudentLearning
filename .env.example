# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Database: Neon PostgreSQL
# Pooled connection for app queries.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neuraljee?sslmode=require
# Unpooled connection for migrations/drizzle-kit.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neuraljee?sslmode=require

# AI provider (required — fail-fast startup if missing)
GEMINI_API_KEY=AIza...

# Vercel Cron authentication (required — minimum 16 chars; `openssl rand -hex 32`)
CRON_SECRET=

# Cache and rate limiting: Upstash Redis
# Key prefix for all Redis writes. Change this if sharing an Upstash instance between apps.
REDIS_KEY_PREFIX=NEURALJEE
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx...

# Optional semantic LLM cache: Upstash Vector
# Create a 768-dimensional dense index when using Gemini text-embedding-004.
UPSTASH_VECTOR_REST_URL=https://xxx-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=xxx...
UPSTASH_VECTOR_LLM_CACHE_NAMESPACE=llm-cache

# Optional LLM observability: Helicone custom logs
HELICONE_API_KEY=sk-helicone-...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Python ingestion pipeline
PYTHON_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neuraljee?sslmode=require
# Python ingestion currently also reads GEMINI_API_KEY.
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
